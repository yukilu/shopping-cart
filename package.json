{
  "name": "shopping-cart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "server:dev": "node ./scripts/run-tsx.cjs watch api/server.ts",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "build:client": "tsc -b && vite build",
    "build:server": "esbuild api/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-server/server.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:node:sqlite --define:process.env.NODE_ENV=\\\"production\\\" --minify",
    "build": "npm run build:client && npm run build:server",
    "start": "node ./scripts/run-tsx.cjs api/server.ts",
    "start:prod": "node dist-server/server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@nutui/nutui-react": "^3.1.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.7.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^5.3.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
